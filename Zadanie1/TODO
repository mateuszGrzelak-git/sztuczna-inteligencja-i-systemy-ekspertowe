#Program ma wykorzystywać pliki a nie z danych wpisywanych do programu

def bfs(graph, start):
if graph.is_goal(start):
return 0
queue = []
visited = set()
queue.append(start)
while queue:
v = queue.pop(0)
if graph.is_goal(v):
return 0
visited.add(v)
for n in graph.neighbors(v):
if not visited.has(n) and not queue.has(n):
queue.append(n)
return 1



głębokość = 20


"""
wszerz = bfs
w głąb = dfs
A*     = astr
"""
