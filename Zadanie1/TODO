/*

Zajecia 8.04

heurystyki muszą być dopuszczalne -  czyli nie przesacowywać



//na poczatku G ma 0
//mozliwe ze funkcja niespojna wyglada inaczej
//Nowak mowi ze dobrze dziala zwlaszcza ze nasze heurystyki sa spojne
//heurystyka niespojna jest gdzies na wiki
funkcja A*(s, G)
{
    P = priority_queue()
    T = set()
    P.insert(s, 0) //tu moze byc dowolna liczba, nie musimy tutaj obliczyc tej heurystyki i zaoszczedzamy czas

    while ~P.isempty()
        v = p.pull()
        if G.isEqual(v):
            return success

        T.add(v)
        for n in G.neighbors():
            if ~T.has(n)
                f = g(n) + h(n,G)
//sprawdzanie czy w stanow otwartych
                if ~P.has(n)
                    P.insert(n, f)
//jesli wynik jest lepszy dajemy mu wiekszy priorytet
                else
                    if P.priority(n) > f
                        P.update(n, f)
    return FAILURE
}



//2 wersja kiedy nie chcemy updatowac

funkcja A*_bez_update(G, s)
{
    P = priority_queue()
    T = set()
    P.insert(s, 0)
    while ~P.isempty()
        v = P.pull()
        if G.isgoal(v)
            return success
        if ~T.has(v)
            T.add(v)
            for n in G.neighbors()
                if ~T.has(n)
                    f = g(n) + h(n,G)
                    P.insert(n,f)
    return FAILURE
}










*/



fn main() {
    // W naszym programie H oznacza heurystyczne
    //używamy strategi:
    // - wszerz
    //     - w głąb
    //     - najpierw najlepszy === A*:
    // a) metryka Hamminga: https://brainly.pl/zadanie/9223198
    // b) metryka Manhattan/miejska: https://brain.fuw.edu.pl/edu/index.php/Matematyka_1_OO/Niestandardowe_metryki
    println!("Hello, world!");





    /*Założenia mojego podejścia

    *) pobranie informacji od uzytkownika
    1) otwarcie pliku wejsciowego
    2) przechowanie informacji w tablicach zgodnie z graficzną prezentacją macierzy: https://obliczone.pl/images/macierze/wyznaczniki/pytania/wyznacznik-macierzy-4x4.gif
        - tab[x][y]
        - x oznacza rzad
        - y oznacza kolumne
        - oczywiscie stosujemy sie do zasad programowania czyli
        - liczba na 1 miejscu to tab[0]

    3.1) definiujemy enum ruchow
    3.2) inicjujemy tablice ruchow dla ponizszych opcji:

    1@ przechodzimy do wyszukiwania wszerz
        to Nowak za nas zrobil dodajemy tylko enum i tablice
    2@ przechodzimy do wyszukiwania w glab
        dziala na tej samej zasadzie co wszerz
    3@ przechodzimy do wyszukiwania A* w poleceniu astr
        podajemy dopuszczalnosc do funkcji


    Bonus: Mile widziane wyszukiwanie grafowe
     */
}

